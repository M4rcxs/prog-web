<!-- Componente de Carrinho -->
<div id="cart" class="fixed top-0 right-0 w-96 h-full bg-white shadow-lg transform translate-x-full transition-transform duration-300 z-50">
  <div class="p-4 border-b flex justify-between items-center">
    <h2 class="text-lg font-bold">Seu Carrinho</h2>
    <button id="close-cart" class="text-gray-500 hover:text-black">
      <i class="material-symbols-outlined">close</i>
    </button>
  </div>
  <div id="cart-items" class="p-4 space-y-4">
    <!-- Os itens do carrinho serão renderizados aqui -->
  </div>
  <div class="p-4 border-t">
    <button id="checkout-button" class="w-full bg-primary text-white py-2 rounded">
      Finalizar Compra
    </button>
  </div>
</div>
<script src="/assets/cartSideBar.js"></script>


