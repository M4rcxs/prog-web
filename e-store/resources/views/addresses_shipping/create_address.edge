<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/js/all.min.js"></script>
<script>
    document.getElementById('load-address').addEventListener('click', async function () {
        const cep = document.getElementById('cep').value;
        if (cep.length !== 8 || isNaN(cep)) {
            alert('Por favor, insira um CEP válido com 8 dígitos.');
            return;
        }

        try {
            const response = await fetch('/calculate-shipping', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ cep })
            });

            const data = await response.json();

            if (data.success) {
                // Preenchendo os campos com os valores retornados
                document.getElementById('state_city').value = `${data.endereco.state} - ${data.endereco.city}`;
                document.getElementById('neighborhood').value = data.endereco.neighborhood || '';
                document.getElementById('street').value = data.endereco.street || '';

                // Habilitar os campos
                document.getElementById('state_city').disabled = false;
                document.getElementById('neighborhood').disabled = false;
                document.getElementById('street').disabled = false;
            } else {
                alert('Erro ao buscar endereço. Tente novamente.');
            }
        } catch (error) {
            alert('Erro ao buscar endereço. Tente novamente.');
        }
    });
</script>
