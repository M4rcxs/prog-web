    <!-- Lista de Endereços -->
    <div class="w-full lg:w-2/3 bg-white p-6 rounded shadow-md">
      <h1 class="text-2xl font-bold mb-6">
        {{ i18n.t('addresses_shipping.addresses_list.title', 'Meus Endereços') }}
      </h1>

      @if (addresses.length > 0)
        <ul>
          @each (address in addresses)
            <li class="border-b border-gray-200 py-4">
              <p><strong>{{ address.full_name }}</strong></p>
              <p>{{ address.street }}, {{ address.number }} - {{ address.neighborhood }}</p>
              <p>{{ address.cep }} - {{ address.state_city }}</p>
              <p><small>{{ i18n.t('addresses_shipping.addresses_list.phone', 'Telefone:') }} {{ address.phone }}</small></p>
            </li>
          @endeach
        </ul>
      @else
        <p class="text-gray-500">
          {{ i18n.t('addresses_shipping.addresses_list.no_addresses', 'Nenhum endereço encontrado.') }}
