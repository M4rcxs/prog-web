<div class="container mx-auto mt-10 px-4">
  <div class="flex flex-col lg:flex-row space-y-4 lg:space-y-0 lg:space-x-6">
    <!-- Menu Profile -->
    <div class="w-full lg:max-w-sm bg-white p-4 rounded shadow-md">
      @include('components/menuProfile')
