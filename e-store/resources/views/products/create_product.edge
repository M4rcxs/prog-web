@include('layouts/main')
    <!-- Contêiner centralizado com a imagem de fundo -->
    <div class="flex justify-center items-center min-h-[100vh] bg-gray">
        <div id="webcrumbs"> 
            <div class='w-[600px] min-h-[600px] bg-neutral-50 shadow-md rounded-lg p-6'>
                <h1 class='font-title text-3xl mb-6'>Cadastrar Produto</h1>
                
                <!-- Formulário para cadastrar o produto -->
                <form action="/products/store" method="POST" class='flex flex-col gap-4'>

                    <div class='flex flex-col'>
                        <label for='name' class='mb-1 text-lg'>Nome do Produto</label>
                        <input id='name' name="name" class='p-2 border rounded-md' type='text' placeholder='Digite o nome do produto' required/>
                    </div>

                    <div class='flex flex-col'>
                        <label for='description' class='mb-1 text-lg'>Descrição</label>
                        <textarea id='description' name="description" class='p-2 border rounded-md' rows='4' placeholder='Digite uma descrição do produto' required></textarea>
                    </div>

                    <div class='flex flex-col'>
                        <label for='imageUrl' class='mb-1 text-lg'>URL da Imagem</label>
                        <input id='imageUrl' name="imageUrl" class='p-2 border rounded-md' type='url' placeholder='Digite a URL da imagem do produto' required/>
                    </div>

                    <div class="flex gap-4">
                        <!-- Campo Preço -->
                        <div class="flex-1 flex flex-col">
                            <label for="price" class="mb-1 text-lg">Preço</label>
                            <input id="price" name="price" class="p-2 border rounded-md" type="number" placeholder="Digite o preço do produto" step="0.01" required />
                        </div>
                    
                        <!-- Campo Quantidade -->
                        <div class="flex-1 flex flex-col">
                            <label for="quantidade" class="mb-1 text-lg">Quantidade</label>
                            <input id="quantidade" name="quantidade" class="p-2 border rounded-md" type="number" placeholder="Digite a quantidade do produto" min="0" required />
                        </div>
                    </div>
                                       
                    
                    <div class='flex flex-col'>
                        <label for='categoriaId' class='mb-1 text-lg'>Categoria</label>
                        <select id='categoriaId' name="categoriaId" class='p-2 border rounded-md'>
                          @each(category in categories)
                            <option value='{{ category.id }}'>{{ category.name }}</option>
                          @endeach
                        </select>
                      </div>

                      <button type="button" class="mt-4 h-[40px] w-full bg-black text-neutral-50 rounded-full">
                        <a href="/categories/create">
                          Cadastrar Categoria
                        </a>
                      </button>

                    <button type="submit" class='mt-4 h-[40px] w-full bg-black text-neutral-50 rounded-full'>
                        Cadastrar Produto
                    </button>
                </form>
            </div> 
        </div>
    </div>
